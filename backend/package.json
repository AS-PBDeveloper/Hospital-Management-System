{
  "name": "backend",
  "type": "module",
  "private": true,
  "scripts": {
    "watch": "bun --watch index.ts",
    "start:ngrok": "ngrok http 5000",
    "start:inngest": "npx inngest-cli@latest dev",
    "start:server": "nodemon --exec bun run src/server.ts",
    "dev": "concurrently -c \"blue,magenta,cyan\" -n \"SERVER,NGROK,INNGEST\" \"bun run start:server\" \"bun run start:ngrok\" \"npm run start:inngest\""
  },
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.2",
    "@google/generative-ai": "^0.24.1",
    "@polar-sh/better-auth": "^1.8.4",
    "@polar-sh/sdk": "^0.49.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "better-auth": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "inngest": "^4.20.0",
    "mongodb": "6.21.0",
    "mongoose": "8",
    "morgan": "^1.12.0",
    "socket.io": "^4.8.3",
    "standardwebhooks": "^1.1.1",
    "uploadthing": "^7.7.4"
  }
}
